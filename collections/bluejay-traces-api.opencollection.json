{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Traces API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Traces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Trace",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/traces/:trace_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "trace_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Trace"
        },
        {
          "info": {
            "name": "Get Span",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/spans/:trace_id/:span_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "trace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "span_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Span"
        },
        {
          "info": {
            "name": "Get All Traces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/traces",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of traces to return"
              }
            ]
          },
          "docs": "Get all traces for the authenticated user's organization."
        }
      ]
    }
  ],
  "bundled": true
}