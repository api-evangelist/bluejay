{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Simulations API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Simulations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Simulation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/simulation/:simulation_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "simulation_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific simulation by ID."
        },
        {
          "info": {
            "name": "Update Simulation",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getbluejay.ai/v1/simulation/:simulation_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "simulation_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "update a specific simulation by id.\n\nonly fields provided in the request body will be updated."
        },
        {
          "info": {
            "name": "Delete Simulation",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/simulation/:simulation_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "simulation_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a specific simulation by ID."
        },
        {
          "info": {
            "name": "Add Digital Humans To Simulation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/simulation/:simulation_id/add-digital-humans",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "simulation_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "add existing digital humans to a simulation without replacing existing associations."
        },
        {
          "info": {
            "name": "Remove Digital Humans From Simulation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/simulation/:simulation_id/remove-digital-humans",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "simulation_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "remove digital humans from a simulation (unlink only); idempotent for missing links."
        }
      ]
    }
  ],
  "bundled": true
}