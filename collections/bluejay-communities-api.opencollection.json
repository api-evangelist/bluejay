{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Communities API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Communities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Community",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/create-community",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new community."
        },
        {
          "info": {
            "name": "Get Community",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/community/:community_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "community_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific community by ID."
        },
        {
          "info": {
            "name": "Delete Community",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/community/:community_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "community_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a specific community by ID."
        },
        {
          "info": {
            "name": "Get Communities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/communities",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "digital_human_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get all communities, optionally filtered by digital human (test case)."
        },
        {
          "info": {
            "name": "Update Community",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getbluejay.ai/v1/update-community/:community_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "community_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific community by ID."
        },
        {
          "info": {
            "name": "Add Digital Humans To Community",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getbluejay.ai/v1/add-to-community/:community_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "community_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add digital humans to an existing community without replacing the current list."
        }
      ]
    }
  ],
  "bundled": true
}