{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Get Simulation Runs API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Get Simulation Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Simulation Runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/get-simulation-runs/:simulation_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "simulation_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get all simulation runs for a specific simulation."
        }
      ]
    }
  ],
  "bundled": true
}