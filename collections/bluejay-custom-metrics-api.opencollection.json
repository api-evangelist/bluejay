{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Custom Metrics API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Custom Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Custom Metric",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/create-custom-metric",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new custom metric."
        },
        {
          "info": {
            "name": "Create Custom Metrics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/create-custom-metrics",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create multiple custom metrics synchronously using a single bulk insert."
