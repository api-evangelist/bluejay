        {
          "info": {
            "name": "Get Custom Metric",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/custom-metric/:metric_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
