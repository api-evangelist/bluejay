            "params": [
              {
                "name": "metric_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific custom metric by ID."
        },
        {
          "info": {
            "name": "Delete Custom Metric",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/custom-metric/:metric_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "metric_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a specific custom metric by ID."
        },
        {
          "info": {
            "name": "Get Custom Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/custom-metrics",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get all custom metrics, optionally filtered by agent, with pagination."
        },
        {
          "info": {
            "name": "Get Custom Metrics By Agent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/custom-metrics-by-agent/:agent_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get all custom metrics for an agent.\n\n**DEPRECATED**: This endpoint is deprecated. Please use GET /custom-metrics?agent_id={agent_id} instead,\nwhich supports pagination and additional features."
        },
        {
          "info": {
            "name": "Update Custom Metric",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getbluejay.ai/v1/update-custom-metric/:metric_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "metric_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific custom metric by ID."
        },
        {
          "info": {
            "name": "Bulk Update Custom Metrics",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getbluejay.ai/v1/update-custom-metrics",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk update custom metrics: apply the same patch to each metric in metric_ids.\nOnly keys present in updates are applied; each key's value (including null) is written."
        }
      ]
    }
  ],
  "bundled": true
}