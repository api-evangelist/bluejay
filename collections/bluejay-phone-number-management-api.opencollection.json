{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Phone Number Management API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Phone Number Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add Phone Number",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/phone-numbers/add",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add Phone Number"
        },
        {
          "info": {
            "name": "Release Phone Number",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/phone-numbers/:phone_number/release",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "phone_number",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Release Phone Number"
        }
      ]
    }
  ],
  "bundled": true
}