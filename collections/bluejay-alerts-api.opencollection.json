{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Alerts API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Alert",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/create-alert",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new alert with optional agent associations"
        },
        {
          "info": {
            "name": "Update Alert",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getbluejay.ai/v1/update-alert/:alert_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "alert_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing alert"
        },
        {
          "info": {
            "name": "Delete Alert",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/alert/:alert_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "alert_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an alert and its agent associations"
        }
      ]
    }
  ],
  "bundled": true
}