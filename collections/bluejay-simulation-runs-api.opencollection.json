{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Simulation Runs API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Simulation Runs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Delete Simulation Result",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/simulation-result/:simulation_result_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "simulation_result_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a single simulation result (one row in run details) by ID."
        },
        {
          "info": {
            "name": "Delete Simulation Run",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/simulation-run/:simulation_run_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "simulation_run_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a single simulation run by ID. This will also delete all associated test results."
        }
      ]
    }
  ],
  "bundled": true
}