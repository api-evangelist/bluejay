{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Add Agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/add-agent",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new agent to the system.\n\nReturns the agent id and a status code."
        },
        {
          "info": {
            "name": "Update Agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/update-agent",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing agent in the system."
        },
        {
          "info": {
            "name": "Update Agent By External Id",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getbluejay.ai/v1/update-agent-by-external-id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing agent in the system by external ID."
        },
        {
          "info": {
            "name": "Get Agent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/agents/:agent_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an agent by ID."
        },
        {
          "info": {
            "name": "Get Agent By External Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/agent-by-external-id/:external_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "external_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an agent by external ID."
        },
        {
          "info": {
            "name": "Get All Agents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/all-agents",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ]
          },
          "docs": "Get all your agents."
        },
        {
          "info": {
            "name": "Delete Agent",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/agent/:agent_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an agent by ID."
        },
        {
          "info": {
            "name": "Generate Http Webhook Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/generate-http-webhook-key",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate a new signing key for an HTTP agent's webhook"
        },
        {
          "info": {
            "name": "Get Http Webhook Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/get-http-webhook-key",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Get the signing key for an HTTP agent's webhook"
        }
      ]
    }
  ],
  "bundled": true
}