{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Twilio SIP Webhook API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Twilio SIP Webhook",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Handle Call Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/call-webhook",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ]
          },
          "docs": "Handle call webhook events\n\nWebhook is triggered when a call is made via Twilio Programmable SIP domain."
        }
      ]
    }
  ],
  "bundled": true
}