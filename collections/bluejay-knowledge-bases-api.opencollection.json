              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add Knowledge Base Version Labels Agent Scoped"
        },
        {
          "info": {
            "name": "Remove Knowledge Base Version Labels Agent Scoped",
            "type": "http"
