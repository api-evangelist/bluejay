{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Knowledge Bases API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Knowledge Bases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Knowledge Base By Label Agent Scoped",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/agents/:agent_id/knowledge-bases",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "label",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "retrieve a single knowledge base by label: /agents/{agent_id}/knowledge-bases?label=... .\n\n- if label is missing -> 400\n- if label resolves to 0 -> 404; >1 -> 400 ambiguous (except latest which should be unique)"
        },
        {
          "info": {
            "name": "List Knowledge Base Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/agents/:agent_id/knowledge-bases/versions",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "label",
                "value": "",
                "type": "query"
              },
              {
                "name": "version",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Knowledge Base Versions"
        },
        {
          "info": {
            "name": "Create Knowledge Base Version Agent Scoped",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/agents/:agent_id/knowledge-bases/versions",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Knowledge Base Version Agent Scoped"
        },
        {
          "info": {
            "name": "Delete Knowledge Base Version By Label Agent Scoped",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/agents/:agent_id/knowledge-bases/versions",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "label",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "delete a knowledge base version by label.\n\n- if label is production -> 400 (must move production first)\n- if label resolves to 0 -> 404; >1 -> 400 ambiguous (except latest which should be unique)\n- if deleting latest, reassign latest to highest remaining version\n- cannot delete if it is the only version"
        },
        {
          "info": {
            "name": "Get Knowledge Base Version Agent Scoped",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/agents/:agent_id/knowledge-bases/versions/:version",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Knowledge Base Version Agent Scoped"
        },
        {
          "info": {
            "name": "Delete Knowledge Base Version Agent Scoped",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/agents/:agent_id/knowledge-bases/versions/:version",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "delete a specific knowledge base version; cannot delete production; cannot delete only version.\n\nif deleting latest, reassign latest to highest remaining version.\nreturns metadata about the deletion."
        },
        {
          "info": {
            "name": "Get Knowledge Base By Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/agents/:agent_id/knowledge-bases/:kb_id",
