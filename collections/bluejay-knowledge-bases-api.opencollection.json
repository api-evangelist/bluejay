            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "kb_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Knowledge Base By Id Agent Scoped"
        },
        {
          "info": {
            "name": "List Knowledge Base Version Labels Agent Scoped",
