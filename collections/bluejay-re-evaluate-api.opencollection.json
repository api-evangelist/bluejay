{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Re-evaluate API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Re-evaluate",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Re Evaluate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/re-evaluate/:call_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "call_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Re-evaluate a call."
        },
        {
          "info": {
            "name": "Re Evaluate Simulation Result",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/re-evaluate-simulation-result/:simulation_result_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "simulation_result_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Re-evaluate a simulation result."
        }
      ]
    }
  ],
  "bundled": true
}