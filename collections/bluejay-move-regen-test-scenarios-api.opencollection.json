{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Move Regen Test Scenarios API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Move Regen Test Scenarios",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Move Regen Test Scenarios Endpoint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/move-regen-test-scenarios",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ]
          },
          "docs": "Regenerates test scenarios with a new goal while preserving scenario descriptions.\n\nAccepts a request with the following structure:\n{\n    agent: Agent;\n    promptId?: string;\n    knowledgeBaseId?: string;\n    scenarios: TestScenario[];\n    newGoal: string;\n}"
        }
      ]
    }
  ],
  "bundled": true
}