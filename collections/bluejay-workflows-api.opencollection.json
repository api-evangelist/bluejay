{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Workflows API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Workflows V2",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/workflow",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "query",
                "description": "If set, only workflows linked to this agent (agent must be in your org)."
              }
            ]
          },
          "docs": "List all workflows_v2 for the authenticated user's organization."
        },
        {
          "info": {
            "name": "Create Workflow V2",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/workflow",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a workflows_v2 row with a React Flow graph definition."
        },
        {
          "info": {
            "name": "Duplicate Workflow V2",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/workflow/:workflow_id/duplicate",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workflow_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new workflows_v2 row copying definition, description, and agent links from the source."
        },
        {
          "info": {
            "name": "Get Workflow V2",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/workflow/:workflow_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workflow_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get one workflows_v2 by ID (organization must match)."
        },
        {
          "info": {
            "name": "Update Workflow V2",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getbluejay.ai/v1/workflow/:workflow_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workflow_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update name, description, agent links, and/or definition (React Flow graph)."
        },
        {
          "info": {
            "name": "Delete Workflow V2",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/workflow/:workflow_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workflow_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a workflows_v2 row."
        }
      ]
    }
  ],
  "bundled": true
}