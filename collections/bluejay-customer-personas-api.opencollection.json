{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bluejay Agents Customer Personas API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Personas",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Customer Persona",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getbluejay.ai/v1/create-customer-persona",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new customer persona."
        },
        {
          "info": {
            "name": "Get Customer Personas By Agent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/customer-personas-by-agent/:agent_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "agent_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get all customer personas for an agent."
        },
        {
          "info": {
            "name": "Get Customer Persona",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getbluejay.ai/v1/customer-persona/:persona_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "persona_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a specific customer persona by ID."
        },
        {
          "info": {
            "name": "Delete Customer Persona",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getbluejay.ai/v1/customer-persona/:persona_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "persona_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a specific customer persona by ID."
        },
        {
          "info": {
            "name": "Update Customer Persona",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getbluejay.ai/v1/update-customer-persona/:persona_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "persona_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific customer persona by ID."
        }
      ]
    }
  ],
  "bundled": true
}